# Copy this file to ".env" and fill it in. Never commit .env to git.

PORT=3000

# Sign your login tokens with this. Any long random string.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. Ignored when DATABASE_URL is set.
SQLITE_PATH=./tanda.db

# Leave empty for SQLite. Set it to use Postgres instead (see docs/DATABASE.md):
# DATABASE_URL=postgres://user:password@host:5432/tanda
DATABASE_URL=

# Ang email na ito ang magiging admin. Mag-register muna sa app gamit ito,
# tapos i-restart ang server. Pagkatapos, buksan ang /admin.html
ADMIN_EMAIL=

# Optional. Without it the app still works; the AI helper is simply hidden.
ANTHROPIC_API_KEY=
